@prefix : <http://example.org/dfki/twinmap/Capabilities/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/dfki/twinmap/Capabilities/> .

<http://example.org/dfki/twinmap/Capabilities/> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/dfki/twinmap/Capabilities/attachedTo
:attachedTo rdf:type owl:ObjectProperty ,
                     owl:SymmetricProperty ,
                     owl:TransitiveProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain :Part ;
            rdfs:range :Part ;
            rdfs:comment "Expresses that one part of a thing is attached to another thing as result of a worker action" ;
            rdfs:label "attachedTo" .


###  http://example.org/dfki/twinmap/Capabilities/attachedWith
:attachedWith rdf:type owl:ObjectProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain :Part ;
              rdfs:range :Connector .


###  http://example.org/dfki/twinmap/Capabilities/containedIn
:containedIn rdf:type owl:ObjectProperty ;
             owl:inverseOf :contains ;
             rdfs:comment "For objects within a storage" ;
             rdfs:label "containedIn" .


###  http://example.org/dfki/twinmap/Capabilities/contains
:contains rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty ;
          rdf:type owl:TransitiveProperty ;
          rdfs:domain :Storage ;
          rdfs:range :Object ;
          rdfs:label "contains" .


###  http://example.org/dfki/twinmap/Capabilities/definedByRule
:definedByRule rdf:type owl:ObjectProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain :Condition ;
               rdfs:range :PDDLRule ;
               rdfs:comment "Relates a given condition to the formal rule defining these conditions" ;
               rdfs:label "definedByRule" .


###  http://example.org/dfki/twinmap/Capabilities/gluedTo
:gluedTo rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :attachedTo .


###  http://example.org/dfki/twinmap/Capabilities/hasCapability
:hasCapability rdf:type owl:ObjectProperty ;
               rdfs:domain :Actor ;
               rdfs:range :Capability ;
               rdfs:label "hasCapability" .


###  http://example.org/dfki/twinmap/Capabilities/hasCondition
:hasCondition rdf:type owl:ObjectProperty ;
              rdfs:domain :Skill ;
              rdfs:range :Condition ;
              rdfs:label "hasCondition" .


###  http://example.org/dfki/twinmap/Capabilities/hasParameter
:hasParameter rdf:type owl:ObjectProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain :Condition ,
                          :Skill ;
              rdfs:range [ rdf:type owl:Class ;
                           owl:unionOf ( :Actor
                                         :Object
                                       )
                         ] ;
              rdfs:comment "The paramters of a given skill, in the sense of objects within the world that are needed or affected when performing the skill" ;
              rdfs:label "hasParameter" .


###  http://example.org/dfki/twinmap/Capabilities/hasPostcondition
:hasPostcondition rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasCondition ;
                  rdfs:domain :Skill ;
                  rdfs:range :Postcondition ;
                  rdfs:label "hasPostcondition" .


###  http://example.org/dfki/twinmap/Capabilities/hasPrecondition
:hasPrecondition rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :hasCondition ;
                 rdfs:domain :Skill ;
                 rdfs:range :Precondition ;
                 rdfs:label "hasPrecondition" .


###  http://example.org/dfki/twinmap/Capabilities/hasSkill
:hasSkill rdf:type owl:ObjectProperty ;
          rdfs:domain :Actor ;
          rdfs:range :Skill ;
          rdfs:label "hasSkill" .


###  http://example.org/dfki/twinmap/Capabilities/heldBy
:heldBy rdf:type owl:ObjectProperty ;
        owl:inverseOf :holding ;
        rdfs:comment "An object carried in the limbs of an actor is heldBy this actor" ;
        rdfs:label "heldBy" .


###  http://example.org/dfki/twinmap/Capabilities/holding
:holding rdf:type owl:ObjectProperty ;
         rdfs:domain :Actor ;
         rdfs:range :Object ;
         rdfs:comment "An actor holding an object has this object in one of its limbs" ;
         rdfs:label "holding" .


###  http://example.org/dfki/twinmap/Capabilities/implementedBy
:implementedBy rdf:type owl:ObjectProperty ;
               owl:inverseOf :implementsCapability ;
               rdfs:comment "A capability as a rather abstract concept of what can be done is usually implemented by one or more skills" ,
                            "implementedBy" .


###  http://example.org/dfki/twinmap/Capabilities/implementsCapability
:implementsCapability rdf:type owl:ObjectProperty ;
                      rdfs:domain :Skill ;
                      rdfs:range :Capability ;
                      rdfs:comment "A skill as a concrete way of solving problems usually implements a capability" ;
                      rdfs:label "implementsCapability" .


###  http://example.org/dfki/twinmap/Capabilities/providesCapability
:providesCapability rdf:type owl:ObjectProperty ;
                    rdfs:domain :Service ;
                    rdfs:range :Capability .


###  http://example.org/dfki/twinmap/Capabilities/providesService
:providesService rdf:type owl:ObjectProperty ;
                 rdfs:domain :Provider ;
                 rdfs:range :Service .


###  http://example.org/dfki/twinmap/Capabilities/safelyAttached
:safelyAttached rdf:type owl:ObjectProperty ;
                rdfs:comment "Expresses that a part is not only attached, but safely attached in the sense that it complies to certain quality standards" ;
                rdfs:label "safelyAttached" .


###  http://example.org/dfki/twinmap/Capabilities/screwedTo
:screwedTo rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :attachedTo .


###  http://example.org/dfki/twinmap/Capabilities/tiedTo
:tiedTo rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :attachedTo .


###  http://example.org/dfki/twinmap/Capabilities/usesTool
:usesTool rdf:type owl:ObjectProperty ;
          rdfs:range :Tool .


#################################################################
#    Data properties
#################################################################

###  http://example.org/dfki/twinmap/Capabilities/isTightened
:isTightened rdf:type owl:DatatypeProperty ;
             rdfs:domain :Screw ;
             rdfs:range xsd:boolean ;
             rdfs:comment "Boolean describing whether a workable object that can be tightened is tightened already" ;
             rdfs:label "isTightened" .


#################################################################
#    Classes
#################################################################

###  http://example.org/dfki/twinmap/Capabilities/Actor
:Actor rdf:type owl:Class ;
       rdfs:comment "Any entity that can perform actions using specific skills" ;
       rdfs:label "Actor" .


###  http://example.org/dfki/twinmap/Capabilities/Assemble
:Assemble rdf:type owl:Class ;
          rdfs:subClassOf :Capability .


###  http://example.org/dfki/twinmap/Capabilities/CableTies
:CableTies rdf:type owl:Class ;
           rdfs:subClassOf :Connector ;
           rdfs:label "CableTies" .


###  http://example.org/dfki/twinmap/Capabilities/Capability
:Capability rdf:type owl:Class ;
            rdfs:comment "Abstract concept of what kind of action an actor is able to perform" ;
            rdfs:label "Capability" .


###  http://example.org/dfki/twinmap/Capabilities/Condition
:Condition rdf:type owl:Class ;
           rdfs:comment "Conditions related to skills to be performed in an environment" ;
           rdfs:label "Condition" .


###  http://example.org/dfki/twinmap/Capabilities/Connector
:Connector rdf:type owl:Class ;
           rdfs:subClassOf :WorkableObject ;
           rdfs:comment "Any worker usable object that can be used to attach objects to other objects" ;
           rdfs:label "Connector" .


###  http://example.org/dfki/twinmap/Capabilities/Glue
:Glue rdf:type owl:Class ;
      rdfs:subClassOf :Connector ;
      rdfs:label "Glue" .


###  http://example.org/dfki/twinmap/Capabilities/Insert
:Insert rdf:type owl:Class ;
        rdfs:subClassOf :Capability .


###  http://example.org/dfki/twinmap/Capabilities/Object
:Object rdf:type owl:Class ;
        rdfs:comment "Any object in the world that is interacted with by an actor" ;
        rdfs:label "Object" .


###  http://example.org/dfki/twinmap/Capabilities/PDDLRule
:PDDLRule rdf:type owl:Class ;
          rdfs:comment "A PDDL rule to express conditions for skills" ;
          rdfs:label "PDDLRule" .


###  http://example.org/dfki/twinmap/Capabilities/Part
:Part rdf:type owl:Class ;
      rdfs:subClassOf :WorkableObject ;
      rdfs:comment "Any part of something to be assembled" ;
      rdfs:label "Part" .


###  http://example.org/dfki/twinmap/Capabilities/Pick
:Pick rdf:type owl:Class ;
      rdfs:subClassOf :Skill ;
      rdfs:comment "Skill for picking up an object" ;
      rdfs:label "Pick" .


###  http://example.org/dfki/twinmap/Capabilities/Place
:Place rdf:type owl:Class ;
       rdfs:subClassOf :Skill ;
       rdfs:comment "Skill for placing an object carried by an actor to a storage" ;
       rdfs:label "Place" .


###  http://example.org/dfki/twinmap/Capabilities/Postcondition
:Postcondition rdf:type owl:Class ;
               rdfs:subClassOf :Condition ;
               owl:disjointWith :Precondition ;
               rdfs:comment "Postconditions of a skill that apply as an effect after a skill is performed" ;
               rdfs:label "Postcondition" .


###  http://example.org/dfki/twinmap/Capabilities/Precondition
:Precondition rdf:type owl:Class ;
              rdfs:subClassOf :Condition ;
              rdfs:comment "Precondition that must be fulfilled for a skill to be performed" ;
              rdfs:label "Precondition" .


###  http://example.org/dfki/twinmap/Capabilities/Process
:Process rdf:type owl:Class .


###  http://example.org/dfki/twinmap/Capabilities/Product
:Product rdf:type owl:Class .


###  http://example.org/dfki/twinmap/Capabilities/Provider
:Provider rdf:type owl:Class .


###  http://example.org/dfki/twinmap/Capabilities/Resource
:Resource rdf:type owl:Class .


###  http://example.org/dfki/twinmap/Capabilities/Screw
:Screw rdf:type owl:Class ;
       rdfs:subClassOf :Connector ;
       rdfs:label "Screw" .


###  http://example.org/dfki/twinmap/Capabilities/Screwdriver
:Screwdriver rdf:type owl:Class ;
             rdfs:subClassOf :Object ;
             rdfs:label "Screwdriver" .


###  http://example.org/dfki/twinmap/Capabilities/Screwing
:Screwing rdf:type owl:Class ;
          rdfs:subClassOf :Skill ;
          rdfs:comment "Skill implementing screwing in the sense of tightening a workable object using a screwdriver" ;
          rdfs:label "Screwing" .


###  http://example.org/dfki/twinmap/Capabilities/Service
:Service rdf:type owl:Class .


###  http://example.org/dfki/twinmap/Capabilities/Skill
:Skill rdf:type owl:Class ;
       rdfs:comment "A specific skill describing how to solve a specific task, usually providing a concrete implementation of a capability" ;
       rdfs:label "Skill" .


###  http://example.org/dfki/twinmap/Capabilities/Storage
:Storage rdf:type owl:Class ;
         rdfs:subClassOf :Object ;
         rdfs:comment "Any object that in some sense can act as a storage by containing other objects" ;
         rdfs:label "Storage" .


###  http://example.org/dfki/twinmap/Capabilities/Table
:Table rdf:type owl:Class ;
       rdfs:subClassOf :Storage ;
       rdfs:label "Table" .


###  http://example.org/dfki/twinmap/Capabilities/Tighten
:Tighten rdf:type owl:Class ;
         rdfs:subClassOf :Capability .


###  http://example.org/dfki/twinmap/Capabilities/Tool
:Tool rdf:type owl:Class .


###  http://example.org/dfki/twinmap/Capabilities/WorkableObject
:WorkableObject rdf:type owl:Class ;
                rdfs:subClassOf :Object ;
                rdfs:comment "Objects that can be targets of skills" ;
                rdfs:label "WorkableObject" .


###  http://example.org/dfki/twinmap/Capabilities/Worker
:Worker rdf:type owl:Class ;
        rdfs:subClassOf :Actor ;
        rdfs:comment "A human worker" ;
        rdfs:label "Worker" .


###  http://example.org/dfki/twinmap/Capabilities/byHand
:byHand rdf:type owl:Class ;
        rdfs:subClassOf :Screwing .


###  http://example.org/dfki/twinmap/Capabilities/byScrewdriver
:byScrewdriver rdf:type owl:Class ;
               rdfs:subClassOf [ owl:intersectionOf ( :Screwing
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :usesTool ;
                                                        owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] .


#################################################################
#    Individuals
#################################################################

###  http://example.org/dfki/twinmap/Capabilities/AssembleToyCar
:AssembleToyCar rdf:type owl:NamedIndividual ,
                         :Service ;
                :providesCapability :Assemble_body_19650 ,
                                    :Insert_body_19650 ,
                                    :Tighten_body_19650 .


###  http://example.org/dfki/twinmap/Capabilities/Assemble_body_19650
:Assemble_body_19650 rdf:type owl:NamedIndividual ,
                              :Assemble ,
                              :Capability .


###  http://example.org/dfki/twinmap/Capabilities/CanScrewByHand
:CanScrewByHand rdf:type owl:NamedIndividual ,
                         :byHand .


###  http://example.org/dfki/twinmap/Capabilities/CanScrewWithTool
:CanScrewWithTool rdf:type owl:NamedIndividual ,
                           :byScrewdriver .


###  http://example.org/dfki/twinmap/Capabilities/Insert_body_19650
:Insert_body_19650 rdf:type owl:NamedIndividual ,
                            :Capability ,
                            :Insert .


###  http://example.org/dfki/twinmap/Capabilities/Tighten_body_19650
:Tighten_body_19650 rdf:type owl:NamedIndividual ,
                             :Capability ,
                             :Tighten .


###  http://example.org/dfki/twinmap/Capabilities/worker_instance
:worker_instance rdf:type owl:NamedIndividual ,
                          :Provider ,
                          :Worker ;
                 :providesService :AssembleToyCar .


