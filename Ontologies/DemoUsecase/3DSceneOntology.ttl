@prefix : <http://www.semanticweb.org/daniel/ontologies/2025/7/untitled-ontology-97/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/daniel/ontologies/2025/7/untitled-ontology-97/> .

<https://twinmap.de/dfki/placeholder/demo/3DScene> rdf:type owl:Ontology ;
                                                    owl:versionIRI <https://twinmap.de/dfki/placeholder/demo/3DScene/0.0.1> ;
                                                    rdfs:comment "A placeholder ontology defined for the TwinMap Demonstrator October 2025, providing necessary classes and relations to set up an example use case describing a 3D toy truck model" .

#################################################################
#    Object Properties
#################################################################

###  https://twinmap.de/dfki/placeholder/demo/3DScene#boundingBoxOf
:boundingBoxOf rdf:type owl:ObjectProperty ;
               owl:inverseOf :hasBounds .


###  https://twinmap.de/dfki/placeholder/demo/3DScene#containsMesh
:containsMesh rdf:type owl:ObjectProperty .


###  https://twinmap.de/dfki/placeholder/demo/3DScene#hasBounds
:hasBounds rdf:type owl:ObjectProperty ;
           rdfs:domain :Object ;
           rdfs:range :BVH .


###  https://twinmap.de/dfki/placeholder/demo/3DScene#hasObject
:hasObject rdf:type owl:ObjectProperty ;
           rdfs:domain :Scene ;
           rdfs:range :Object .


#################################################################
#    Data properties
#################################################################

###  https://twinmap.de/dfki/placeholder/demo/3DScene#hasID
:hasID rdf:type owl:DatatypeProperty ;
       rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  https://twinmap.de/dfki/placeholder/demo/3DScene#BVH
:BVH rdf:type owl:Class .


###  https://twinmap.de/dfki/placeholder/demo/3DScene#Cube
:Cube rdf:type owl:Class ;
      rdfs:subClassOf :Primitive .


###  https://twinmap.de/dfki/placeholder/demo/3DScene#Elliptoid
:Elliptoid rdf:type owl:Class ;
           rdfs:subClassOf :Primitive .


###  https://twinmap.de/dfki/placeholder/demo/3DScene#Material
:Material rdf:type owl:Class .


###  https://twinmap.de/dfki/placeholder/demo/3DScene#Mesh
:Mesh rdf:type owl:Class .


###  https://twinmap.de/dfki/placeholder/demo/3DScene#Model
:Model rdf:type owl:Class .


###  https://twinmap.de/dfki/placeholder/demo/3DScene#Object
:Object rdf:type owl:Class .


###  https://twinmap.de/dfki/placeholder/demo/3DScene#Primitive
:Primitive rdf:type owl:Class .


###  https://twinmap.de/dfki/placeholder/demo/3DScene#Scene
:Scene rdf:type owl:Class .


###  https://twinmap.de/dfki/placeholder/demo/3DScene#Sphere
:Sphere rdf:type owl:Class ;
        rdfs:subClassOf :Primitive .


