@prefix : <https://twinmap.de/dfki/placeholder/demo/parts/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://twinmap.de/dfki/placeholder/demo/parts/> .

<https://twinmap.de/dfki/placeholder/demo/parts> rdf:type owl:Ontology ;
                                                  owl:versionIRI <https://twinmap.de/dfki/placeholder/demo/parts/0.0.1> .

#################################################################
#    Object Properties
#################################################################

###  https://twinmap.de/dfki/placeholder/demo/parts#connectedWith
:connectedWith rdf:type owl:ObjectProperty ;
               rdfs:domain :Part ;
               rdfs:range :Screw .


###  https://twinmap.de/dfki/placeholder/demo/parts#consistsOf
:consistsOf rdf:type owl:ObjectProperty ;
            rdfs:domain :Car ;
            rdfs:range :Part .


#################################################################
#    Classes
#################################################################

###  https://twinmap.de/dfki/placeholder/demo/parts#Battery
:Battery rdf:type owl:Class ;
         rdfs:subClassOf :Part .


###  https://twinmap.de/dfki/placeholder/demo/parts#BatteryCase
:BatteryCase rdf:type owl:Class ;
             rdfs:subClassOf :Part .


###  https://twinmap.de/dfki/placeholder/demo/parts#Body
:Body rdf:type owl:Class ;
      rdfs:subClassOf :Part .


###  https://twinmap.de/dfki/placeholder/demo/parts#Button
:Button rdf:type owl:Class ;
        rdfs:subClassOf :Part .


###  https://twinmap.de/dfki/placeholder/demo/parts#Car
:Car rdf:type owl:Class .


###  https://twinmap.de/dfki/placeholder/demo/parts#FlatHeadScrew
:FlatHeadScrew rdf:type owl:Class ;
               rdfs:subClassOf :Screw ;
               owl:disjointWith :PinHeadScrew .


###  https://twinmap.de/dfki/placeholder/demo/parts#HexHead
:HexHead rdf:type owl:Class ;
         rdfs:subClassOf :Screw .


###  https://twinmap.de/dfki/placeholder/demo/parts#Part
:Part rdf:type owl:Class .


###  https://twinmap.de/dfki/placeholder/demo/parts#PhilipsHead
:PhilipsHead rdf:type owl:Class ;
             rdfs:subClassOf :Screw .


###  https://twinmap.de/dfki/placeholder/demo/parts#PinHeadScrew
:PinHeadScrew rdf:type owl:Class ;
              rdfs:subClassOf :Screw .


###  https://twinmap.de/dfki/placeholder/demo/parts#Screw
:Screw rdf:type owl:Class .


###  https://twinmap.de/dfki/placeholder/demo/parts#SlottedHead
:SlottedHead rdf:type owl:Class ;
             rdfs:subClassOf :Screw .


###  https://twinmap.de/dfki/placeholder/demo/parts#Wheel
:Wheel rdf:type owl:Class ;
       rdfs:subClassOf :Part .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :HexHead
                :PhilipsHead
                :SlottedHead
              )
] .


