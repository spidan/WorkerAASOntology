@prefix : <http://example.org/dfki/twinmap/toyCar/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/dfki/twinmap/toyCar/> .

<http://example.org/dfki/twinmap/toyCar/> rdf:type owl:Ontology ;
                                           owl:versionIRI <http://example.org/dfki/twinmap/toyCar/1.0.0> .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/dfki/twinmap/toyCar/attachedAt
:attachedAt rdf:type owl:ObjectProperty ;
            rdfs:domain :Part ;
            rdfs:range :Attachment .


###  http://example.org/dfki/twinmap/toyCar/fixedWith
:fixedWith rdf:type owl:ObjectProperty ;
           owl:inverseOf :fixes ;
           rdfs:domain :Part ;
           rdfs:range :Connector .


###  http://example.org/dfki/twinmap/toyCar/fixes
:fixes rdf:type owl:ObjectProperty .


###  http://example.org/dfki/twinmap/toyCar/hasPart
:hasPart rdf:type owl:ObjectProperty ;
         rdfs:domain :Toy ;
         rdfs:range :Part .


###  http://example.org/dfki/twinmap/toyCar/hasWheel
:hasWheel rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :hasPart .


#################################################################
#    Classes
#################################################################

###  http://example.org/dfki/twinmap/toyCar/Attachment
:Attachment rdf:type owl:Class .


###  http://example.org/dfki/twinmap/toyCar/Battery
:Battery rdf:type owl:Class ;
         rdfs:subClassOf :Part .


###  http://example.org/dfki/twinmap/toyCar/Bicycle
:Bicycle rdf:type owl:Class ;
         rdfs:subClassOf :Bike ;
         owl:disjointWith :Motorcycle .


###  http://example.org/dfki/twinmap/toyCar/Bike
:Bike rdf:type owl:Class ;
      rdfs:subClassOf :Toy ;
      owl:disjointWith :Car .


###  http://example.org/dfki/twinmap/toyCar/Bus
:Bus rdf:type owl:Class ;
     rdfs:subClassOf :Car .


###  http://example.org/dfki/twinmap/toyCar/Car
:Car rdf:type owl:Class ;
     rdfs:subClassOf :Toy .


###  http://example.org/dfki/twinmap/toyCar/Connector
:Connector rdf:type owl:Class ;
           rdfs:subClassOf :Part .


###  http://example.org/dfki/twinmap/toyCar/Light
:Light rdf:type owl:Class ;
       rdfs:subClassOf :Part .


###  http://example.org/dfki/twinmap/toyCar/Motorcycle
:Motorcycle rdf:type owl:Class ;
            rdfs:subClassOf :Bike .


###  http://example.org/dfki/twinmap/toyCar/Part
:Part rdf:type owl:Class .


###  http://example.org/dfki/twinmap/toyCar/PassengerCar
:PassengerCar rdf:type owl:Class ;
              rdfs:subClassOf :Car .


###  http://example.org/dfki/twinmap/toyCar/Screw
:Screw rdf:type owl:Class ;
       rdfs:subClassOf :Connector .


###  http://example.org/dfki/twinmap/toyCar/Toy
:Toy rdf:type owl:Class .


###  http://example.org/dfki/twinmap/toyCar/Truck
:Truck rdf:type owl:Class ;
       rdfs:subClassOf :Car .


###  http://example.org/dfki/twinmap/toyCar/Wheel
:Wheel rdf:type owl:Class ;
       rdfs:subClassOf :Part .


#################################################################
#    Individuals
#################################################################

###  http://example.org/dfki/twinmap/toyCar/Screw1
:Screw1 rdf:type owl:NamedIndividual ,
                 :Screw .


###  http://example.org/dfki/twinmap/toyCar/Screw2
:Screw2 rdf:type owl:NamedIndividual ,
                 :Screw .


###  http://example.org/dfki/twinmap/toyCar/Screw3
:Screw3 rdf:type owl:NamedIndividual ,
                 :Screw .


###  http://example.org/dfki/twinmap/toyCar/Screw4
:Screw4 rdf:type owl:NamedIndividual ,
                 :Screw .


###  http://example.org/dfki/twinmap/toyCar/ToyTruck
:ToyTruck rdf:type owl:NamedIndividual ,
                   :Truck ;
          :hasWheel :WheelBackLeft ,
                    :WheelBackRight ,
                    :WheelFrontLeft ,
                    :WheelFrontRight .


###  http://example.org/dfki/twinmap/toyCar/WheelAttachBL
:WheelAttachBL rdf:type owl:NamedIndividual ,
                        :Attachment .


###  http://example.org/dfki/twinmap/toyCar/WheelAttachBR
:WheelAttachBR rdf:type owl:NamedIndividual ,
                        :Attachment .


###  http://example.org/dfki/twinmap/toyCar/WheelAttachFL
:WheelAttachFL rdf:type owl:NamedIndividual ,
                        :Attachment .


###  http://example.org/dfki/twinmap/toyCar/WheelAttachFR
:WheelAttachFR rdf:type owl:NamedIndividual ,
                        :Attachment .


###  http://example.org/dfki/twinmap/toyCar/WheelBackLeft
:WheelBackLeft rdf:type owl:NamedIndividual ,
                        :Wheel ;
               :attachedAt :WheelAttachBL ;
               :fixedWith :Screw1 .


###  http://example.org/dfki/twinmap/toyCar/WheelBackRight
:WheelBackRight rdf:type owl:NamedIndividual ,
                         :Wheel ;
                :attachedAt :WheelAttachBR ;
                :fixedWith :Screw2 .


###  http://example.org/dfki/twinmap/toyCar/WheelFrontLeft
:WheelFrontLeft rdf:type owl:NamedIndividual ,
                         :Wheel ;
                :attachedAt :WheelAttachFL ;
                :fixedWith :Screw3 .


###  http://example.org/dfki/twinmap/toyCar/WheelFrontRight
:WheelFrontRight rdf:type owl:NamedIndividual ,
                          :Wheel ;
                 :attachedAt :WheelAttachFR ;
                 :fixedWith :Screw4 .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Attachment
                :Part
                :Toy
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Battery
                :Light
                :Wheel
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Bus
                :PassengerCar
                :Truck
              )
] .


